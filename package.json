{
  "name": "json-p3",
  "version": "2.3.1",
  "author": "James Prior",
  "repository": {
    "type": "git",
    "url": "https://github.com/jg-rp/json-p3.git"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jest": "^30.0.0",
    "@vitest/browser-playwright": "^5.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "^1.63.0",
    "tinybench": "^6.2.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "bugs": {
    "url": "https://github.com/jg-rp/json-p3/issues"
  },
  "description": "JSONPath, JSON Pointer and JSON Patch",
  "homepage": "https://github.com/jg-rp/json-p3",
  "license": "MIT",
  "type": "module",
  "main": "dist/json-p3.esm.js",
  "module": "dist/json-p3.esm.js",
  "browser": "dist/json-p3.browser.esm.js",
  "browser-min": "dist/json-p3.browser.min.esm.js",
  "jsdeliver": "dist/json-p3.browser.min.esm.js",
  "types": "dist/json-p3.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test:browser": "bun run dist && vitest run --config vitest.browser.config.ts --browser",
    "test:node": "bun run dist && vitest run --config vitest.node.bundle.config.ts",
    "build:types": "bun run tsc -p tsconfig.build.json",
    "build:js": "bun build.ts",
    "dist": "rm -rf ./dist && bun run build:js && bun run build:types",
    "lint": "bun run oxlint",
    "type-check": "bun run tsc -p tsconfig.build.json --noEmit",
    "publish": "bun run dist && bun publish",
    "fmt": "bun run oxfmt",
    "fmt:check": "bun run oxfmt --check"
  },
  "keywords": [
    "JSON",
    "JSONPath",
    "JSON Pointer",
    "JSON Patch"
  ],
  "dependencies": {
    "iregexp-check": "^0.1.2"
  }
}
